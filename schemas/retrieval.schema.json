{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetrievalResults",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chunk_id", "text", "source", "score"],
        "properties": {
          "chunk_id": {"type": "string"},
          "text": {"type": "string"},
          "source": {"type": "string"},
          "score": {"type": "number"},
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
